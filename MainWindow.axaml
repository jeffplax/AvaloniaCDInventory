<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvaloniaCDInventory"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="AvaloniaCDInventory.MainWindow"
        x:CompileBindings= "False"
        Title="Discogs Inventory Manager (Avalonia Edition)"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

    <TabControl Name="MainTabControl" SelectedIndex="0" SelectionChanged="MainTabControl_SelectionChanged">
        <TabItem Header="🎵 Master Library">
            <DockPanel LastChildFill="True">

                <Border DockPanel.Dock="Top" Height="60" Background="#252525" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">                        
                        <Button Name="BtnLoad" Content="Connect DB" Background="#0078D7" Foreground="White" Click="BtnConnectDB_Click"/>
                        <Button Name="BtnRefresh" Content="Refresh" IsEnabled="False" Click="BtnRefresh_Click"/>
                        <Button Name="BtnExportLibrary" Content="⬇️ Export" Background="#217346" Foreground="White" Click="BtnExportLibrary_Click"/>
                        <TextBox Text="{Binding ManualEntryText}" Watermark="Enter UPC or Catalog ID" Width="180" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        <Button Command="{Binding SearchManualEntryCommand}" Content="🔍 Search" Background="#0078D7" Foreground="White" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <ComboBox Name="CmbFilter" SelectedItem="{Binding SelectedFilter}" Width="100">
                            <x:String>All</x:String>
                            <x:String>Artist</x:String>
                            <x:String>Title</x:String>
                            <x:String>Year</x:String>
                            <x:String>Format</x:String>
                            <x:String>Label</x:String>
                            <x:String>Genre</x:String>
                        </ComboBox>

                        <TextBox Name="TxtSearch" Width="200" Watermark="Search..." Text="{Binding SearchQuery}"/>

                        <Button Content="⚙️ Columns" Background="#444444" Foreground="White">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Toggle Columns" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <CheckBox Content="UPC" IsChecked="True" Tag="0" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Artist" IsChecked="True" Tag="1" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Sort Artist" IsChecked="True" Tag="2" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Title" IsChecked="True" Tag="3" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Year" IsChecked="True" Tag="4" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Format" IsChecked="True" Tag="5" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Label" IsChecked="True" Tag="6" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Genre" IsChecked="True" Tag="7" IsCheckedChanged="ToggleCol_Click"/>
                                        <CheckBox Content="Styles" IsChecked="True" Tag="8" IsCheckedChanged="ToggleCol_Click"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <TextBlock Name="LblCount" Text="{Binding AlbumCountText}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0078D7" Margin="20,0,0,0"/>

                        <TextBlock Name="LblStatus" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid Name="GridAlbums" ItemsSource="{Binding AllAlbums}" SelectedItem="{Binding SelectedAlbum}" AutoGenerateColumns="False" IsReadOnly="False" 
                        GridLinesVisibility="All" BorderThickness="1" BorderBrush="Gray"
                        CellEditEnded="GridAlbums_CellEditEnded" SelectionChanged="GridAlbums_SelectionChanged"
                        KeyDown="GridAlbums_KeyDown"
                        CanUserResizeColumns="True" 
                        CanUserReorderColumns="True"
                        RowDetailsVisibilityMode="VisibleWhenSelected"> 
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Margin="10" Padding="10" Background="#1E1E1E" CornerRadius="5" BorderBrush="#333333" BorderThickness="1">
                                <Grid RowDefinitions="Auto,*">                            
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                                        <TextBlock Grid.Column="0" Text="Tracklist" FontWeight="Bold" Foreground="#0078D7" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✖" Width="25" Height="25" Padding="0" 
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Background="Transparent" Foreground="Gray" Cursor="Hand"
                                                Click="BtnCloseTracklist_Click"/>
                                    </Grid>                            
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tracks}" x:DataType="local:Track" AutoGenerateColumns="False" IsReadOnly="True" 
                                            HeadersVisibility="None" GridLinesVisibility="None" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Position}" Width="50" Foreground="Gray"/>
                                            <DataGridTextColumn Binding="{Binding TrackTitle}" Width="*" />
                                            <DataGridTextColumn Binding="{Binding Duration}" Width="80" Foreground="Gray"/>
                                        </DataGrid.Columns>
                                    </DataGrid>                            
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" IsReadOnly="True" Width="120"/>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="200"/>
                        <DataGridTextColumn Header="Sort Artist" Binding="{Binding SortArtist}" Width="200"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="250"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="80"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="120"/>
                        <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="150"/>
                        <DataGridTextColumn Header="Styles" Binding="{Binding Styles}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Name="TabWishList" Header="🛒 Wish List">
            <Grid RowDefinitions="Auto,*">
                
                <Border Grid.Row="0" Background="#252525" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="BtnExportWishlist" Content="⬇️ Export CSV" Background="#217346" Foreground="White" Click="BtnExportWishlist_Click"/>
                        <TextBlock Text="New Target:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0078D7"/>
                        <TextBox Text="{Binding WishArtist}" Watermark="Artist" Width="200"/>
                        <TextBox Text="{Binding WishTitle}" Watermark="Title" Width="250"/>
                        <ComboBox SelectedItem="{Binding WishFormat}" Width="100">
                            <x:String>CD</x:String>
                            <x:String>Vinyl</x:String>
                            <x:String>Box Set</x:String>
                            <x:String>Digital</x:String>
                        </ComboBox>
                        <TextBox Text="{Binding WishNotes}" Watermark="Notes" Width="200"/>
                        <Button Command="{Binding SaveWishCommand}" Content="💾 Save" Background="#0078D7" Foreground="White"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" Name="GridWishList" ItemsSource="{Binding WishlistItems}"  
                          KeyDown="GridWishList_KeyDown" AutoGenerateColumns="False" IsReadOnly="True" 
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="Gray">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="200"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="250"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header= "ℹ️ About">
            <Border Background= "#252525"  Padding= "40"  Margin= "40"  CornerRadius= "8"
                    BorderBrush=  "Gray" BorderThickness= "1" 
                    HorizontalAlignment= "Center" VerticalAlignment= "Center">
                <StackPanel Spacing= "10" HorizontalAlignment= "Center">
                    <TextBlock Text= "💿 Avalonia CD Inventory Desktop" FontWeight= "Bold" FontSize= "28" Foreground= "#0078D7"  HorizontalAlignment= "Center"/>
                    <TextBlock Name= "LblVersion"  Text= "Version Loading. . . " FontSize= "16" Foreground= "LightGray" HorizontalAlignment= "Center"/>
                    <TextBlock Name= "LblBuildDate" Text= "Build Date Loading. . . " FontSize= "14" Foreground= "Gray" HorizontalAlignment= "Center"/>
                    <Button Content="Close" Background="#7701D8" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0" Click="BtnCloseAbout_Click"/>
                    <Separator Margin= "0,20" Background= "#333333"/>
                    <TextBlock Text= "A modern desktop application for managing your CD collection, built with Avalonia UI and C#." 
                               FontSize= "14" Foreground= "LightGray" TextAlignment= "Center" HorizontalAlignment= "Center" Margin= "0,10,0,0"/>
                    <TextBlock Text= "Author:  Jeff P. " FontSize= "18" Foreground= "LightGray" HorizontalAlignment= "Center"/>
                    <TextBlock Text= "GitHub:  github.com/jeffplax/AvaloniaCDInventory" FontSize= "14" Foreground= "LightGray" HorizontalAlignment= "Center"/>
                    <TextBlock Text= "Felicia's Database Emporium:  feliciasdatabase.com" FontSize= "14" Foreground= "LightGray" HorizontalAlignment= "Center"/>
                    <TextBlock Text="Powered by Avalonia UI &amp; SQLite" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>
</Window>